	<properties>
		<java.version>21</java.version>
		<log4j2.version>2.19.0</log4j2.version>
		
    <!-- Maven compiler settings for source and target compatibility -->
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>

    <!-- SonarQube project configuration -->
    <!-- Project key and name should follow the format: batchname-groupno-projectname -->
    <!-- Example: Oct24-SET1-Java-React-RT1-A-group12-facebook -->
    <sonar.projectKey>Sep25-SET3-Java-React-FS-RT1-A-group7-taxtracker</sonar.projectKey> <!-- Unique identifier for the project in SonarQube -->
    <sonar.projectName>Sep25-SET3-Java-React-FS-RT1-A-group7-taxtracker</sonar.projectName> <!-- Display name of the project in SonarQube -->

    <!-- Exclude specific packages and classes from code coverage analysis -->
    <sonar.coverage.exclusions>
        src/main/java/com/infy/exception/**,
        src/main/java/com/infy/entity/**,
        src/main/java/com/infy/dto/**,
        src/main/java/com/infy/config/**,
        src/main/java/com/infy/utility/**,
        src/main/java/com/infy/TaxTrackerApplication*,
        src/main/java/com/infy/repository/**,
        src/main/java/com/infy/security/**
    </sonar.coverage.exclusions>

    <!-- Ensure build fails if SonarQube quality gate fails -->
    <sonar.qualitygate.wait>true</sonar.qualitygate.wait> <!-- Wait for quality gate result -->
    <sonar.qualitygate.failOnSonarQubeExitCode>true</sonar.qualitygate.failOnSonarQubeExitCode> <!-- Fail build if quality gate fails -->
    <sonar.qualitygate.timeout>300</sonar.qualitygate.timeout> <!-- Timeout in seconds for quality gate check -->

    <!-- Define source and test directories for SonarQube analysis -->
    <sonar.sources>src/main/java</sonar.sources>
    <sonar.tests>src/test/java</sonar.tests>

    <!-- Specify compiled class locations -->
    <sonar.java.binaries>target/classes</sonar.java.binaries>
    <sonar.java.test.binaries>target/test-classes</sonar.java.test.binaries>

    <!-- Path to JaCoCo coverage report -->
    <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

    <!-- Path to JUnit test reports -->
    <sonar.junit.reportPaths>target/surefire-reports</sonar.junit.reportPaths>

    <!-- Ignore specific SonarQube rules for all Java files -->
    <sonar.issue.ignore.multicriteria>e1,e2</sonar.issue.ignore.multicriteria>
    <sonar.issue.ignore.multicriteria.e1.ruleKey>java:S6813</sonar.issue.ignore.multicriteria.e1.ruleKey> <!-- Ignore rule S6813 -->
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S4502</sonar.issue.ignore.multicriteria.e2.ruleKey> <!-- Ignore rule S4502 -->
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
	</properties>
